/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML sempre revalidado: um deploy novo chega no refresh seguinte
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Compatibilidade: links antigos de convite são redirecionados para a entrada
/convite
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Página interna (não listada): novidades + candidatura SVAT
/estudo360-novidades-e-svat.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/estudo360-novidades-semana-26-10.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/estudo360-novidades-semana-03-11.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/docs-candidatura-svat/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# Proposta pública: link privado, nunca indexar
/p/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
