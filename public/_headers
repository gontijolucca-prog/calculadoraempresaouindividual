/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML sempre revalidado: um deploy novo chega no refresh seguinte
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Convite por link: tem token no URL, nunca indexar
/convite
  X-Robots-Tag: noindex
  Cache-Control: no-store

/convite.html
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Página interna (não listada): novidades + candidatura SVAT
/estudo360-novidades-e-svat.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/docs-candidatura-svat/*
  X-Robots-Tag: noindex

# Proposta pública: link privado, nunca indexar
/p/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
