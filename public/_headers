/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML sempre revalidado: um deploy novo chega no refresh seguinte
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Assets com hash no nome: mudam a cada deploy. Cache de 1 h (não "immutable"):
# se um pedido apanhar o deploy a meio, o Pages pode devolver o index.html no
# lugar do ficheiro — com immutable esse HTML ficava cacheado para sempre e a
# app rebentava com "Failed to fetch dynamically imported module".
/assets/*
  Cache-Control: public, max-age=3600

# Compatibilidade: links antigos de convite são redirecionados para a entrada
/convite
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Página interna (não listada): novidades + candidatura SVAT
/estudo360-novidades-e-svat.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/estudo360-novidades-semana-26-10.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/estudo360-novidades-semana-03-11.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/estudo360-novidades-semana-09-11.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/docs-candidatura-svat/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/exemplos-exportacoes-2026-11-03/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# Proposta pública: link privado, nunca indexar
/p/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
