rules_version = '2';

// Firestore Security Rules — Estudo 360
// Requer Firebase Auth para escrita. Leitura pública para updates (compatibilidade).
// Multi-tenant: cada utilizador só acede aos seus dados (empresas/{uid}).

service cloud.firestore {
  match /databases/{database}/documents {

    match /updates/{docId} {
      allow read: if true;

      allow create: if request.auth != null && isValidUpdateCreate(request.resource.data);

      allow update: if request.auth != null && isToggleOnly(resource.data, request.resource.data);

      allow delete: if request.auth != null && resource.data.aprovado == true;
    }

    // Registry de empresas por utilizador (multi-tenant via officeId = UID do utilizador).
    // Cada utilizador só lê/escreve os seus próprios dados. 'shared' é modo demo/local sem auth.
    match /empresas/{officeId} {
      allow read: if officeId == 'shared' || (request.auth != null && request.auth.uid == officeId);
      allow write: if (officeId == 'shared' || (request.auth != null && request.auth.uid == officeId)) && isValidEmpresasPayload(request.resource.data);
    }

    // Gabinete — gestão reliable + live. Cada doc tem _updatedAt para ordenar.
    // 'shared' permite demo local sem login; com login isola por uid.
    match /gabinete/{officeId}/{col}/{docId} {
      allow read: if officeId == 'shared' || (request.auth != null && request.auth.uid == officeId);
      allow write: if (officeId == 'shared' || (request.auth != null && request.auth.uid == officeId)) && isValidGabineteDoc(request.resource.data);
    }
    // Permitir listar as subcoleções (necessário para collectionGroup ou list)
    match /gabinete/{officeId} {
      allow read: if officeId == 'shared' || (request.auth != null && request.auth.uid == officeId);
      allow write: if false;
    }

    // Sugestões de melhoria recolhidas pelo AI Contabilista.
    // Autenticação obrigatória para criar/atualizar.
    match /ai_suggestions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidSuggestion(request.resource.data);
      allow update: if request.auth != null && isSuggestionStatusOnly(resource.data, request.resource.data);
      allow delete: if false;
    }

    // Bloquear tudo o resto explicitamente até existir auth real.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidSuggestion(d) {
  return d.keys().hasOnly(['title', 'detail', 'area', 'autor', 'vista', 'createdAt', 'status'])
      && d.title is string && d.title.size() > 0 && d.title.size() < 300
      && d.detail is string && d.detail.size() < 3000
      && d.createdAt is number
      && d.status is string && (d.status == 'novo' || d.status == 'visto' || d.status == 'feito')
      && (!('area' in d) || (d.area is string && d.area.size() < 200))
      && (!('autor' in d) || (d.autor is string && d.autor.size() < 200))
      && (!('vista' in d) || (d.vista is string && d.vista.size() < 100));
}

function isSuggestionStatusOnly(before, after) {
  return after.diff(before).affectedKeys().hasOnly(['status'])
      && after.status is string
      && (after.status == 'novo' || after.status == 'visto' || after.status == 'feito');
}

function isValidUpdateCreate(data) {
  // `autor` é opcional (compatibilidade com versões antigas da app que ainda
  // criam sem assinatura), mas quando vem tem de ser um nome curto.
  return data.keys().hasOnly(['text', 'atualizado', 'aprovado', 'createdAt', 'autor'])
      && data.text is string
      && data.text.size() > 0
      && data.text.size() < 1000
      && data.atualizado is bool
      && data.aprovado is bool
      && (!('autor' in data) || (data.autor is string && data.autor.size() > 0 && data.autor.size() < 100));
}

function isToggleOnly(before, after) {
  // Permite alterar só os flags e as respectivas assinaturas (quem marcou +
  // quando). Tudo o resto — text, createdAt, autor — fica imutável por exclusão:
  // qualquer chave fora desta lista no diff chumba a regra.
  return after.diff(before).affectedKeys().hasOnly(
        ['atualizado', 'aprovado', 'atualizadoPor', 'atualizadoEm', 'aprovadoPor', 'aprovadoEm'])
      && after.atualizado is bool
      && after.aprovado is bool
      && (!('atualizadoPor' in after) || (after.atualizadoPor is string && after.atualizadoPor.size() < 100))
      && (!('aprovadoPor' in after) || (after.aprovadoPor is string && after.aprovadoPor.size() < 100))
      && (!('atualizadoEm' in after) || after.atualizadoEm is number)
      && (!('aprovadoEm' in after) || after.aprovadoEm is number);
}

function isValidEmpresasPayload(data) {
  // Estrutura esperada: { list: [...], updatedAt: <number> }.
  // Limite estrutural para evitar payloads absurdos.
  return data.keys().hasOnly(['list', 'updatedAt'])
      && data.list is list
      && data.list.size() < 500
      && data.updatedAt is number;
}

function isValidGabineteDoc(data) {
  // Docs do gabinete são flexíveis; só validamos tamanho e presença de _updatedAt quando existe.
  // Permite qualquer payload < 500KB com _updatedAt numérico se presente.
  return data.size() < 500
      && (!('_updatedAt' in data) || data._updatedAt is number);
}
