rules_version = '2';

// Firestore Security Rules — Estudo 360
// Segurança por gabinete: dados em `gabinete/{gabineteId}/*` só para membros.
// Cada `gabinetes/{gabineteId}` guarda os UIDs dos membros e os respetivos cargos.

service cloud.firestore {
  match /databases/{database}/documents {

    // Convites por link foram descontinuados. A migração remove os documentos
    // antigos com a conta de serviço; o cliente nunca volta a ler estes tokens.
    match /convites/{token} {
      allow read, write: if false;
    }

    match /updates/{docId} {
      allow read: if true;
      allow create: if isAppAdmin() && isValidUpdateCreate(request.resource.data);
      // As notas de reunião são um arquivo append-only: uma gravação nova cria
      // uma versão; nenhuma versão anterior pode ser alterada ou apagada.
      allow update, delete: if false;
    }

    // ——— Empresas por utilizador ———
    // Legado: doc único empresas/{uid} com {list, updatedAt} — mantido para migração.
    match /empresas/{officeId} {
      allow read: if request.auth != null && gabIsUser(officeId);
      allow create, update: if request.auth != null && gabIsUser(officeId) && isValidEmpresasPayload(request.resource.data);
      allow delete: if request.auth != null && gabIsUser(officeId);
    }
    // Escalável: subcoleção empresas/{uid}/chunks/{idx} — N docs de ~20 empresas cada, ilimitado.
    match /empresas/{officeId}/chunks/{chunkId} {
      allow read: if request.auth != null && gabIsUser(officeId);
      allow create, update: if request.auth != null && gabIsUser(officeId) && isValidChunkPayload(request.resource.data);
      allow delete: if request.auth != null && gabIsUser(officeId);
    }
    // Legado shared: só leitura para migração (autenticado), nunca escrita.
    match /empresas/shared {
      allow read: if isAppAdmin();
      allow write: if false;
    }
    match /empresas/shared/chunks/{docId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }

    // Marca de migração única da carteira antiga da conta para um gabinete.
    match /migrations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['empresasParaGabinete', 'at'])
        && request.resource.data.empresasParaGabinete is string
        && request.resource.data.at is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function isAppAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'admin@estudo360.pt';
    }
    function souDonoDoGabinete(gabineteId) {
      return request.auth != null && (
        request.auth.uid == resource.data.ownerUid
        || request.auth.uid == gabineteId
      );
    }
    function souAdminDoGabinete(gabineteId) {
      return request.auth != null && (
        request.auth.uid == resource.data.ownerUid
        || request.auth.uid == gabineteId
        || (request.auth.uid in resource.data.members
            && resource.data.members[request.auth.uid].role == 'admin')
        || roleHasPerm(gabineteId, 'gerir-equipa')
      );
    }
    // ——— Gabinetes (meta) ———
    // Leitura apenas ao dono e aos membros efetivos. As associações por email
    // são processadas pela conta de serviço antes de o UID aparecer aqui.
    match /gabinetes/{gabineteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerUid
        || request.auth.uid in resource.data.memberUids
      );
      // O id tem de ser um id de gabinete gerado pela app (`gab_…`) ou o próprio
      // uid (path legado). Sem isto, qualquer conta criava `gabinetes/shared` ou
      // `gabinetes/{uidDeOutraPessoa}` e passava a `gabIsUser` nesses namespaces.
      allow create: if request.auth != null
        && request.auth.token.get('employeeOnly', false) == false
        && request.auth.uid == request.resource.data.ownerUid
        && (gabineteId == request.auth.uid || gabineteId.matches('^gab_[a-z0-9]{8,}$'));
      // Só o dono/admin altera a equipa. Auto-adesão por link foi removida.
      allow update: if request.auth != null && (
        souDonoDoGabinete(gabineteId)
        || (souAdminDoGabinete(gabineteId) && request.resource.data.ownerUid == resource.data.ownerUid)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // ——— Gabinete por gabineteId ———
    // Cargos: admin (dono ou role=admin) · contabilista · estagiaria.
    // Membro sem role (legado) conta como contabilista; gabinete/{uid} legado = admin.
    function gabData(gabineteId) {
      return get(/databases/$(database)/documents/gabinetes/$(gabineteId)).data;
    }
    function gabIsOwnerUid(gabineteId) {
      return request.auth != null && request.auth.uid == gabineteId;
    }
    function gabIsMember(gabineteId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/gabinetes/$(gabineteId))
        && (request.auth.uid == gabData(gabineteId).ownerUid
            || request.auth.uid in gabData(gabineteId).memberUids);
    }
    function gabIsUser(gabineteId) {
      // `shared` é namespace reservado (migração) — nunca conta como gabinete.
      return gabineteId != 'shared' && (gabIsOwnerUid(gabineteId) || gabIsMember(gabineteId));
    }
    function gabRole(gabineteId) {
      return gabIsOwnerUid(gabineteId) ? 'admin'
        : (request.auth.uid == gabData(gabineteId).ownerUid ? 'admin'
        : (!(request.auth.uid in gabData(gabineteId).members) ? 'contabilista'
        : gabData(gabineteId).members[request.auth.uid].role));
    }
    function gabRoleIs(gabineteId, roles) {
      return gabIsUser(gabineteId) && gabRole(gabineteId) in roles;
    }
    function gabIsAdmin(gabineteId) {
      return gabIsUser(gabineteId) && (
        gabRole(gabineteId) == 'admin'
        || roleHasPerm(gabineteId, 'gerir-gabinete')
      );
    }
    // Só clientes/obrigações/cofre são restritos a admin+contabilista; os
    // restantes módulos são trabalho de qualquer membro (estagiária incluída).
    // Cargos personalizados: as permissões vivem em gabinetes/{id}.customRoles.
    function roleHasPerm(gabineteId, perm) {
      return gabIsUser(gabineteId)
        && gabRole(gabineteId) in gabData(gabineteId).customRoles
        && perm in gabData(gabineteId).customRoles[gabRole(gabineteId)].permissoes;
    }
    function podeVerCofre(gabineteId) {
      return gabRoleIs(gabineteId, ['admin', 'contabilista']) || roleHasPerm(gabineteId, 'ver-cofre');
    }
    function podeEditarCol(gabineteId, col) {
      return gabRoleIs(gabineteId, ['admin', 'contabilista'])
        || (col == 'cofre' && roleHasPerm(gabineteId, 'editar-cofre'))
        || (col == 'clientes' && roleHasPerm(gabineteId, 'editar-clientes'))
        || (col == 'obrigacoes' && roleHasPerm(gabineteId, 'gerir-obrigacoes'));
    }
    function podeApagarCol(gabineteId, col) {
      // O cofre exige sempre poder vê-lo: apagar às cegas não faz sentido.
      return (col != 'cofre' && (gabRoleIs(gabineteId, ['admin', 'contabilista'])
            || roleHasPerm(gabineteId, 'apagar')
            || roleHasPerm(gabineteId, 'purgar')))
        || (col == 'cofre' && podeVerCofre(gabineteId) && (gabRoleIs(gabineteId, ['admin', 'contabilista'])
            || roleHasPerm(gabineteId, 'apagar')
            || roleHasPerm(gabineteId, 'editar-cofre')));
    }
    function podeLixeira(gabineteId) {
      return gabRoleIs(gabineteId, ['admin', 'contabilista'])
        || roleHasPerm(gabineteId, 'restaurar')
        || roleHasPerm(gabineteId, 'apagar');
    }
    function isColRestrita(col) {
      return col == 'cofre' || col == 'clientes' || col == 'obrigacoes';
    }
    function isColLixeira(col) {
      return col == 'clientes' || col == 'tarefas' || col == 'obrigacoes' || col == 'contactosGeral'
        || col == 'alertasGeral' || col == 'ocorrencias' || col == 'documentos';
    }
    // Soft-delete (deletedAt > 0) e restauro (deletedAt passa a 0) exigem cargo
    // de admin/contabilista — a estagiária não apaga nem restaura.
    function isLixeiraChange(before, after) {
      return ('deletedAt' in after && after.deletedAt > 0)
        || (before.keys().hasAny(['deletedAt']) && before.deletedAt > 0 && (!('deletedAt' in after) || after.deletedAt == 0));
    }

    match /gabinete/{officeId}/{col}/{docId} {
      // O cofre só é legível por admin/contabilista — a estagiária nem por API.
      allow read: if gabIsUser(officeId)
        && (col != 'cofre' || podeVerCofre(officeId));
      allow create: if gabIsUser(officeId)
        && isValidGabineteDoc(request.resource.data)
        && (!isColRestrita(col) || podeEditarCol(officeId, col));
      allow update: if gabIsUser(officeId)
        && isValidGabineteDoc(request.resource.data)
        && (
          isColRestrita(col)
            ? podeEditarCol(officeId, col)
            : (!isLixeiraChange(resource.data, request.resource.data) || podeLixeira(officeId))
        );
      // Purga definitiva: só admin (cofre: admin+contabilista; restantes: membros).
      allow delete: if gabIsUser(officeId) && (
        isColLixeira(col)
          ? (gabRoleIs(officeId, ['admin']) || roleHasPerm(officeId, 'purgar'))
          : podeApagarCol(officeId, col)
      );
    }
    match /gabinete/{officeId} {
      allow read: if gabIsUser(officeId);
      allow write: if false;
    }
    match /gabinetes/{gabineteId}/settings/{docId} {
      allow read: if gabIsUser(gabineteId);
      allow write: if gabIsAdmin(gabineteId);
    }
    // Legado gabinete/shared/* : leitura para migração, sem escrita
    match /gabinete/shared/{col}/{docId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }
    match /gabinete/shared {
      allow read: if isAppAdmin();
      allow write: if false;
    }

    // Tabela de preços/honorários — leitura pública, escrita só autenticada
    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAppAdmin();
    }

    // ——— Propostas públicas (link só-leitura) ———
    // Snapshot mínimo (cards + branding + expiração). O documento do gabinete
    // nunca é exposto: só o autor publica, qualquer pessoa lê até expirar.
    match /publicPropostas/{slug} {
      allow read: if request.time.toMillis() < resource.data.expiresAt.toMillis();
      allow create: if isPublicDeck(request.resource.data, slug);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && isPublicDeck(request.resource.data, slug);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Registo de acessos (quem entra na app): cada utilizador só pode CRIAR
    // eventos próprios; só o admin os lê. Update/delete bloqueados (imutável).
    match /auth_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'type', 'at', 'verified', 'app'])
        && (request.resource.data.type == 'signup' || request.resource.data.type == 'login');
      allow read: if request.auth != null && request.auth.token.email == 'admin@estudo360.pt';
      allow update, delete: if false;
    }

    // Coleções administrativas do novo sistema de logins da equipa.
    // employeeProfiles é o único documento técnico legível pelo próprio
    // colaborador, para a app mostrar o email real e o estado de revogação.
    match /employeeCredentials/{credentialId} {
      allow read, write: if false;
    }
    match /employeeLoginIndexes/{emailHash} {
      allow read, write: if false;
    }
    match /pendingMemberships/{emailHash}/{document=**} {
      allow read, write: if false;
    }
    match /employeeProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /ai_suggestions/{docId} {
      // Feedback interno do bot: só o admin lê e muda estados. Antes qualquer
      // conta autenticada lia as sugestões de todos os gabinetes.
      allow read: if isAppAdmin();
      allow create: if request.auth != null && isValidSuggestion(request.resource.data);
      allow update: if isAppAdmin() && isSuggestionStatusOnly(resource.data, request.resource.data);
      allow delete: if false;
    }


    match /audit_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts is number
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() < 80;
      allow read: if request.auth != null
        && (request.auth.token.email == 'admin@estudo360.pt' || request.auth.uid == resource.data.uid);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidSuggestion(d) {
  return d.keys().hasOnly(['title', 'detail', 'area', 'autor', 'vista', 'createdAt', 'status'])
      && d.title is string && d.title.size() > 0 && d.title.size() < 300
      && d.detail is string && d.detail.size() < 3000
      && d.createdAt is number
      && d.status is string && (d.status == 'novo' || d.status == 'visto' || d.status == 'feito')
      && (!('area' in d) || (d.area is string && d.area.size() < 200))
      && (!('autor' in d) || (d.autor is string && d.autor.size() < 200))
      && (!('vista' in d) || (d.vista is string && d.vista.size() < 100));
}

function isSuggestionStatusOnly(before, after) {
  return after.diff(before).affectedKeys().hasOnly(['status'])
      && after.status is string
      && (after.status == 'novo' || after.status == 'visto' || after.status == 'feito');
}

function isValidUpdateCreate(data) {
  return data.keys().hasOnly(['text', 'atualizado', 'aprovado', 'createdAt', 'autor'])
      && data.text is string
      && data.text.size() > 0
      && data.text.size() < 1000
      && data.atualizado is bool
      && data.aprovado is bool
      && (!('autor' in data) || (data.autor is string && data.autor.size() > 0 && data.autor.size() < 100));
}

function isValidEmpresasPayload(data) {
  return data.keys().hasOnly(['list', 'updatedAt'])
      && data.list is list
      && data.list.size() < 500
      && data.updatedAt is number
      // Validação leve de conteúdo para mitigar bomb JSON — cada empresa tem nome/nif curtos
      // Parênteses obrigatórios: sem eles o `||` escapava à conjunção acima.
      && (data.list.size() == 0 || data.list[0].keys().hasAny(['nome', 'nif', 'profile']));
}

function isValidChunkPayload(data) {
  return data.keys().hasOnly(['list', 'updatedAt', 'chunk'])
      && data.list is list
      && data.list.size() <= 30
      && data.updatedAt is number
      && data.chunk is number
      && (data.list.size() == 0 || data.list[0].keys().hasAny(['nome', 'nif', 'profile']));
}

/** Snapshot público de uma proposta: campos fechados, slug = id do doc, expiração obrigatória. */
function isPublicDeck(d, slug) {
  return request.auth != null
      && d.keys().hasOnly(['slug','titulo','cards','tema','clienteNome','escritorio','expiresAt','updatedAt','ownerUid'])
      && d.slug is string && d.slug == slug
      && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() < 300
      && d.cards is list && d.cards.size() > 0 && d.cards.size() <= 14
      && d.tema in ['claro','escuro','brand']
      && d.escritorio is map
      && d.expiresAt is timestamp
      && d.updatedAt is number
      && d.ownerUid == request.auth.uid;
}

function isValidGabineteDoc(data) {
  return data.size() < 200
      && (!('_updatedAt' in data) || data._updatedAt is number)
      // Limita strings longas para evitar bomb de storage e XSS persistido
      && (!('titulo' in data) || (data.titulo is string && data.titulo.size() < 300))
      && (!('nome' in data) || (data.nome is string && data.nome.size() < 200))
      && (!('segredo' in data) || (data.segredo is string && data.segredo.size() < 500))
      && (!('cipher' in data) || data.cipher.size() < 800)
      && (!('username' in data) || (data.username is string && data.username.size() < 300))
      && (!('url' in data) || (data.url is string && data.url.size() < 500));
}
